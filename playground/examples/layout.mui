// This is the same builder DSL used by native MUI.
col![
    text("MAKE IT YOURS").text_size(24.).fill(Ink),
    row![
        block(92., 92.).pill().fill(Primary),
        block(92., 92.).radius(24.).fill(Secondary),
        block(92., 92.).radius(8.).fill(Tertiary),
    ].gap(16.),
    block(320., 20.).pill()
        .fill(Gradient::vertical(Primary, Secondary)),
]
.gap(24.).pad(32.).center()
.radius(32.).fill(Surface)
.stroke(Dim).stroke_width(1.)
