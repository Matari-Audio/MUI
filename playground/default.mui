container([
  container([
    item("osc").text("Oscillator").pad(S).on_tap("osc"),
    item("filter").text("Filter").pad(S)
      .extend_to("panel").color(Raised).on_tap("filter"),
    item("fx").text("Effects").pad(S).on_tap("fx"),
  ]).layout(Row).center().width(Fill).gap(8px).pad(12px),

  item("panel").layout(Grid(3)).width(Fill).pad(18px).gap(12px)
    .children([
      item("cutoff").text("Cutoff").width(90px).height(88px)
        .round(20px).color(Primary1).on_tap("cutoff"),
      item("resonance").text("Resonance").width(90px).height(88px)
        .round(20px).color(Primary2).on_tap("resonance"),
      item("drive").text("Drive").width(90px).height(88px)
        .round(20px).color(Primary3).on_tap("drive"),
    ]),
]).layout(Column).width(Fill).height(Hug).gap(12px)
  .merge(["filter", "panel"])
